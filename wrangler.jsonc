{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gitone",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "gitone.langersword.in", "custom_domain": true }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://gitone.langersword.in"
  },
  // Native cache for lib/redis.ts on Workers: card cache, GitHub token
  // health and the scout counter. Create/rotate with
  // `npx wrangler kv namespace create GITONE_KV`.
  "kv_namespaces": [
    { "binding": "GITONE_KV", "id": "8d67e9c706f64ec397ea485d4fb30942" }
  ],
  "observability": { "enabled": true }
}
